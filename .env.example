# Root subpath this app is mounted at behind nginx.
ROOT_PATH=/bounding-box

# --- orcarouter (OpenAI-compatible endpoint) ---
# Required for detection. Copy this file to .env and fill in the key.
ORCAROUTER_API_KEY=
ORCAROUTER_BASE_URL=https://api.orcarouter.ai/v1
ORCAROUTER_MODEL=qwen/qwen3.8-27b-free
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2

# Image handling
MAX_IMAGE_DIMENSION=1280
JPEG_QUALITY=85
PDF_RENDER_DPI=150
MAX_UPLOAD_MB=25