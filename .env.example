# Root subpath this app is mounted at behind nginx.
ROOT_PATH=/bounding-box

# --- Vision LLM (any OpenAI-compatible endpoint) ---
# Required for detection. Copy this file to .env and fill in the key.
# Point LLM_BASE_URL at the /v1 root of your provider (OpenRouter, orcarouter,
# a local vLLM/Ollama server, ...) and set LLM_MODEL to the exact model id.
LLM_API_KEY=
LLM_BASE_URL=https://api.orcarouter.ai/v1
LLM_MODEL=qwen/qwen3.8-27b-free
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2

# Image handling
MAX_IMAGE_DIMENSION=1600
LLM_MAX_IMAGE_DIMENSION=1024
JPEG_QUALITY=85
LLM_JPEG_QUALITY=80
PDF_RENDER_DPI=150
MAX_UPLOAD_MB=25

# Per-IP rate limit on /detect (trailing window)
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_WINDOW_SECONDS=60

# Admin section — password-gated /admin area (delete history, etc.)
ADMIN_PASSWORD=
SESSION_SECRET=

# Detections left 'pending' (uploaded but never confirmed) older than this
# are swept, along with their files, next time someone visits the home page.
PENDING_TTL_HOURS=24

# Items per page on /history.
HISTORY_PAGE_SIZE=20